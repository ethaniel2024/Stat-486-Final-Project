from pathlib import Path
import numpy as np
import pandas as pd

# Locate the project and data
ROOT = Path(__file__).resolve().parents[1]
DATA_PATH = ROOT / "data" / "processed" / "Broadway_Data.csv"
RESULTS_DIR = ROOT / "results"
RESULTS_DIR.mkdir(parents=True, exist_ok=True)

# Load and prepare data
df = pd.read_csv(DATA_PATH)

df["Week Ending"] = pd.to_datetime(df["Week Ending"])
df["This Week Gross"] = (
    df["This Week Gross"]
    .astype(str)
    .str.replace(r"[$,]", "", regex=True)
)
df["This Week Gross"] = pd.to_numeric(
    df["This Week Gross"], errors="coerce"
)

df = df.dropna(subset=["Show", "Week Ending", "This Week Gross"])
df = df.sort_values(["Show", "Week Ending"]).copy()

# Previous observed gross for the same show
df["Previous Gross"] = df.groupby("Show")["This Week Gross"].shift(1)
df["Previous Week"] = df.groupby("Show")["Week Ending"].shift(1)

# Only use a previous observation exactly one week earlier
df["Days Between"] = (df["Week Ending"] - df["Previous Week"]).dt.days
df = df[df["Days Between"] == 7].copy()

# Hold out 2026 for chronological evaluation
test = df[df["Week Ending"] >= "2026-01-01"].copy()

# Persistence prediction
test["Predicted Gross"] = test["Previous Gross"]
test["Absolute Error"] = (
    test["This Week Gross"] - test["Predicted Gross"]
).abs()
test["Squared Error"] = (
    test["This Week Gross"] - test["Predicted Gross"]
) ** 2

# Metrics
mae = test["Absolute Error"].mean()
rmse = np.sqrt(test["Squared Error"].mean())

print("Persistence Baseline")
print("--------------------")
print("Test observations:", len(test))
print("Test period:", test["Week Ending"].min(), "to", test["Week Ending"].max())
print(f"MAE:  ${mae:,.2f}")
print(f"RMSE: ${rmse:,.2f}")

# Save predictions for inspection
test[
    [
        "Show",
        "Week Ending",
        "Previous Gross",
        "This Week Gross",
        "Predicted Gross",
        "Absolute Error",
    ]
].to_csv(RESULTS_DIR / "baseline_predictions.csv", index=False)
