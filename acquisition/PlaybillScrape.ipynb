def scrape_week(date):
    #Scrape one week of Broadway grosses
    url = f"https://playbill.com/grosses?week={date}"

    headers = {
        "User-Agent": "MyScraperForACollegeClass_OnAppleMacUsingVSCode (emanbnelson@gmail.com)"
    }

    response = requests.get(url, headers=headers)
    if response.status_code != 200:
        print(f"Failed for {date}")
        return None

    soup = BeautifulSoup(response.text, "html.parser")

    # Find the grosses table
    table = soup.find("table")
    if table is None:
        print(f"No table found for {date}")
        return None

    # Extract headers
    headers = [th.get_text(strip=True) for th in table.find_all("th")]

    rows = []
    for tr in table.find_all("tr")[1:]:
        cols = [td.get_text(strip=True) for td in tr.find_all("td")]
        if len(cols) == len(headers):
            rows.append(cols)

    df = pd.DataFrame(rows, columns=headers)
    df["Week Ending"] = date

    return df


def scrape_multiple_weeks(start, end):
    #Scrape all Sundays between start and end dates
    dates = pd.date_range(start, end, freq="W-SUN")

    all_dfs = []

    for d in dates:
        date_str = d.strftime("%Y-%m-%d")
        print(f"Scraping {date_str}...")

        df = scrape_week(date_str)
        if df is not None:
            all_dfs.append(df)

        time.sleep(.5)  # be polite

    if all_dfs:
        return pd.concat(all_dfs, ignore_index=True)
    else:
        return pd.DataFrame()

#Scrape desired weeks
df = scrape_multiple_weeks("2022-01-01", "2026-11-01")

# Clean numeric columns (optional but recommended)
def clean_money(x):
    if pd.isna(x):
        return None

    x = str(x).strip()

    if x in ["", "N/A", "-", "--"]:
        return None

    try:
        return float(x.replace("$", "").replace(",", ""))
    except ValueError:
        return None

def clean_percent(x):
    if pd.isna(x):
        return None

    x = str(x).strip()

    if x in ["", "N/A", "-", "--"]:
        return None

    try:
        return float(x.replace("%", ""))
    except ValueError:
        return None

for col in df.columns:
    if "Gross" in col:
        df[col] = df[col].apply(clean_money)
    if "%" in col:
        df[col] = df[col].apply(clean_percent)

print(df.head())
